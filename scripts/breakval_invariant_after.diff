diff --git a/src/gc.c b/src/gc.c
index cda8b54..7517888 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -531,6 +531,20 @@ mrb_gc_unregister(mrb_state *mrb, mrb_value obj)
   }
 }
 
+/* breakval instrumentation (mruby.cve-2022-1212): mrb_breakval_active is set
+   in the OP_R_BREAK (cci > CINFO_NONE) branch of mrb_vm_exec around break_new,
+   with mrb_breakval_val the break value. The check below fires when break_new's
+   allocation runs while the break value is reachable from neither the GC arena
+   nor the live VM stack, which is the state in which that allocation's GC step
+   would free the break value. stdio/stdlib are included unconditionally here
+   (gc.c includes them only under MRB_GC_STRESS / GC_PROFILE) and mrb_ci_nregs
+   is forward-declared (its prototype appears later in gc.c). */
+#include <stdio.h>
+#include <stdlib.h>
+mrb_int mrb_ci_nregs(mrb_callinfo *ci);
+int mrb_breakval_active = 0;
+mrb_value mrb_breakval_val;
+
 MRB_API struct RBasic*
 mrb_obj_alloc(mrb_state *mrb, enum mrb_vtype ttype, struct RClass *cls)
 {
@@ -538,6 +552,33 @@ mrb_obj_alloc(mrb_state *mrb, enum mrb_vtype ttype, struct RClass *cls)
   static const RVALUE RVALUE_zero = { { { NULL, NULL, MRB_TT_FALSE } } };
   mrb_gc *gc = &mrb->gc;
 
+  if (mrb_breakval_active && !mrb_immediate_p(mrb_breakval_val)) {
+    struct RBasic *bvp = mrb_basic_ptr(mrb_breakval_val);
+    int bv_reach = 0;
+    int bi;
+    for (bi = 0; bi < gc->arena_idx; bi++) {
+      if (gc->arena[bi] == bvp) { bv_reach = 1; break; }
+    }
+    if (!bv_reach) {
+      struct mrb_context *bc = mrb->c;
+      if (bc && bc->stbase && bc->ci) {
+        size_t be = (bc->ci->stack ? (size_t)(bc->ci->stack - bc->stbase) : 0)
+                    + (size_t)mrb_ci_nregs(bc->ci);
+        size_t bk;
+        if (bc->stbase + be > bc->stend) be = (size_t)(bc->stend - bc->stbase);
+        for (bk = 0; bk < be; bk++) {
+          if (!mrb_immediate_p(bc->stbase[bk]) && mrb_basic_ptr(bc->stbase[bk]) == bvp) {
+            bv_reach = 1; break;
+          }
+        }
+      }
+    }
+    if (!bv_reach) {
+      fprintf(stderr, "BREAKVAL-INVARIANT break value unreachable from arena or live stack at break_new allocation\n");
+      abort();
+    }
+  }
+
   if (cls) {
     enum mrb_vtype tt;
 
