--- a/mrbgems/mruby-io/src/io.c
+++ b/mrbgems/mruby-io/src/io.c
@@ -54,6 +54,7 @@ typedef mrb_int pid_t;
 
 #include <errno.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
 
 
@@ -567,6 +568,20 @@ mrb_io_initialize_copy(mrb_state *mrb, mrb_value copy)
     mrb_free(mrb, fptr_copy);
   }
   fptr_copy = (struct mrb_io *)mrb_io_alloc(mrb);
+  {
+    void *iocopy_old = DATA_PTR(copy);
+    if (iocopy_old != NULL) {
+      void *iocopy_op = mrb_data_check_get_ptr(mrb, orig, &mrb_io_type);
