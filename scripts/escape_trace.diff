+/* ESCAPE-TRACE (scripts/escape_trace.diff, instrumentation only): append one
+ * line per call to /tmp/escape_trace.log with the number of examined
+ * characters of each class and of buffer growths. Changes no result. */
+static void
+escape_trace (const char *func, int sp, int hi, int pl, int ct, int grow)
+{
+  FILE *f = fopen ("/tmp/escape_trace.log", "a");
+  if (!f)
+    return;
+  fprintf (f, "ESCAPE-TRACE %s in=%d special=%d high=%d plain=%d ctl=%d grow=%d\n",
+           func, sp + hi + pl + ct, sp, hi, pl, ct, grow);
+  fclose (f);
+}
+#define ESCAPE_COUNT(c, sp, hi, pl, ct)                                      \
+  do                                                                         \
+    {                                                                        \
+      if ((c) >= 127)                                                        \
+        hi++;                                                                \
+      else if ((c) == 34 || (c) == 39 || (c) == 38 || (c) == 60 || (c) == 62 \
+               || (c) == 96 || (c) == 123 || (c) == 125)                     \
+        sp++;                                                                \
+      else if ((c) >= 20)                                                    \
+        pl++;                                                                \
+      else                                                                   \
+        ct++;                                                                \
+    }                                                                        \
+  while (0)
+
