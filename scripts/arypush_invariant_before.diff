diff --git a/mrbgems/mruby-compiler/core/codegen.c b/mrbgems/mruby-compiler/core/codegen.c
index 729f57566..90915d957 100644
--- a/mrbgems/mruby-compiler/core/codegen.c
+++ b/mrbgems/mruby-compiler/core/codegen.c
@@ -1908,6 +1908,11 @@ gen_assignment(codegen_scope *s, node *tree, node *rhs, int sp, int val)
         n++;
       }
       else {
+        if (n != 15) {          /* ARYPUSH-INVARIANT: only a packed argument array (n == 15) takes the rhs */
+          char msg[96];
+          snprintf(msg, sizeof(msg), "ARYPUSH-INVARIANT rhs appended to R%d, an unpacked argument (n=%d)", cursp()-1, n);
+          codegen_error(s, msg);
+        }
         pop();
         genop_2(s, OP_ARYPUSH, cursp(), 1);
       }
